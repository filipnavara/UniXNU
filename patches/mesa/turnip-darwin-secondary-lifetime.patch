+static void
+tu_darwin_check_secondaries(struct tu_cmd_buffer *cmd, char where)
+{
+   for (uint32_t i = 0; i < cmd->darwin_secondary_count; i++) {
+      struct tu_cmd_buffer *s = cmd->darwin_secondaries[i].cmd;
+      const uint32_t now = p_atomic_read(&s->darwin_gen);
+      if (now == cmd->darwin_secondaries[i].gen)
