+
+/* asteroids: the last 256 BOs darwin_bo_finish zeroed, with where from (backtrace), so a command stream that still names one
+ * (tu_darwin_note_low_ib) can tell who finished it: "LF h<handle low word> i<iova> s<KiB> a<ms ago> <caller offsets in this
+ * library, hex>" as a second line beside LI. */
+#include <execinfo.h>
+#include <dlfcn.h>
+struct darwin_finish_record {
+   const void *bo;
+   uint64_t handle, iova, size, ns;
+   void *frames[7];
+   char destroying[48];
+};
+thread_local char tu_darwin_destroying[48];
+static struct darwin_finish_record darwin_finishes[256];
+static uint32_t darwin_finish_count;
+void tu_darwin_note_text(struct tu_device *dev, const char *text);
+
+static void
+darwin_record_finish(const struct tu_bo *bo)
+{
+   struct darwin_finish_record *r = &darwin_finishes[(p_atomic_inc_return(&darwin_finish_count) - 1) & 255];
+   r->bo = NULL;
+   r->handle = bo->darwin_handle;
+   r->iova = bo->iova;
+   r->size = bo->size;
+   r->ns = os_time_get_nano();
+   memset(r->frames, 0, sizeof(r->frames));
+   backtrace(r->frames, 7);
+   memcpy(r->destroying, tu_darwin_destroying, sizeof(r->destroying));
+   p_atomic_set(&r->bo, (const void *)bo);
+}
+
+static void
+darwin_note_finished(struct tu_device *dev, const struct tu_bo *bo)
+{
+   const uint32_t count = p_atomic_read(&darwin_finish_count);
+   Dl_info self = {};
+   dladdr((const void *)&darwin_note_finished, &self);
+   const uintptr_t base = (uintptr_t)self.dli_fbase;
+   for (uint32_t k = 0; k < 256 && k < count; k++) {
+      const struct darwin_finish_record *r = &darwin_finishes[(count - 1 - k) & 255];
+      if (p_atomic_read(&r->bo) != bo)
+         continue;
+      char text[64];
+      if (r->destroying[0]) {
+         /* Freed by tu_cmd_buffer_destroy: which command buffer and threads, rather than the stack (vkTrimCommandPool's). */
+         snprintf(text, sizeof(text), "LF a%llu %s", (unsigned long long)((os_time_get_nano() - r->ns) / 1000000), r->destroying);
+         tu_darwin_note_text(dev, text);
+         return;
+      }
+      int n = snprintf(text, sizeof(text), "LF h%x i%llx s%llu a%llu", (uint32_t)r->handle, (unsigned long long)r->iova,
+                       (unsigned long long)(r->size >> 10), (unsigned long long)((os_time_get_nano() - r->ns) / 1000000));
+      /* frames[0] is darwin_record_finish, [1] darwin_bo_finish: the callers from [2] on. */
+      for (unsigned f = 2; f < 7 && n > 0 && n < (int)sizeof(text) - 8; f++) {
+         const uintptr_t at = (uintptr_t)r->frames[f];
+         n += snprintf(text + n, sizeof(text) - n, " %lx", (unsigned long)(at >= base ? at - base : 0));
+      }
+      tu_darwin_note_text(dev, text);
+      return;
+   }
+   tu_darwin_note_text(dev, "LF none");
 }
 
