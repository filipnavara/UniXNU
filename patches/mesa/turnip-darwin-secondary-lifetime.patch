+/* asteroids: one diagnostic line per process for each tag (its first two characters), as darwin_note_failure's (64 bytes). */
+void tu_darwin_note_text(struct tu_device *dev, const char *text);
+void
+tu_darwin_note_text(struct tu_device *dev, const char *text)
+{
+   static char seen[8][2];
+   static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+   if (!dev || !text || !text[0])
+      return;
+   pthread_mutex_lock(&lock);
+   unsigned i = 0;
+   for (; i < 8 && seen[i][0]; i++)
+      if (seen[i][0] == text[0] && seen[i][1] == text[1])
+         break;
+   const bool fresh = i < 8 && !seen[i][0];
+   if (fresh) {
+      seen[i][0] = text[0];
+      seen[i][1] = text[1];
+   }
+   pthread_mutex_unlock(&lock);
+   if (!fresh)
+      return;
+   /* "T " sends the line to the kernel's second report line (NativeAdrenoPublish.cpp runCore: the Turnip phase's line), which nothing
+    * else writes on this board, so the frequent PF lines on the first one never hide it; the board prints both on every change. */
+   NativeAdrenoAbiMetadata req = {};
+   req.reserved = 0x4641494cu;   /* 'FAIL': no handler, so only the report line keeps it */
+   req.text[0] = 'T';
+   req.text[1] = ' ';
+   const size_t len = strnlen(text, sizeof(req.text) - 2);
+   memcpy(req.text + 2, text, len);
+   req.bytes = (uint32_t)(len + 2);
+   (void)dw_call(NativeAdrenoMethodSetMetadata, &req, sizeof(req), NULL, 0);
+}
